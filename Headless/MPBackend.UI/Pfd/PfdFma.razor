@* Flight mode annunciator (spec pfd.fma): LATERAL | STATUS | VERTICAL on the top strip. *@
@inherits PfdPart

<g>
    <rect x="0" y="0" width="800" height="34" fill="#0B1A33" />
    <T X="12" Y="25" V="@Fields.LateralActive" Size="22" W="700" Fill="var(--p-green)" Class="@FlashClass" />
    <T X="110" Y="25" V="@Fields.LateralArmed" Size="16" />
    @if (S.LinkLost)
    {
        <rect x="290" y="4" width="220" height="26" fill="var(--p-red)" />
        <T X="400" Y="24" V="TELEMETRY LOST" A="middle" Size="18" W="700" />
    }
    else if (S.Failsafe)
    {
        <rect x="290" y="4" width="220" height="26" fill="var(--p-red)" />
        <T X="400" Y="24" V="FAILSAFE" A="middle" Size="18" W="700" />
    }
    else
    {
        <T X="360" Y="25" V="@(S.Armed ? "ARMED" : "DISARMED")" A="end" Size="18" W="700" Fill="@(S.Armed ? "var(--p-green)" : "#fff")" />
        <rect x="372" y="6" width="56" height="22" fill="none" stroke="@AuthColor" stroke-width="1.5" />
        <T X="400" Y="24" V="@Fields.Authority" A="middle" Size="18" W="700" Fill="@(Fields.StatusCaution ? "var(--p-yellow)" : AuthColor)" />
        <T X="440" Y="25" V="@S.Mode.ToUpperInvariant()" Size="15" Fill="var(--p-gray300)" />
    }
    <T X="690" Y="25" V="@Fields.VerticalArmed" A="end" Size="16" />
    <T X="788" Y="25" V="@Fields.VerticalActive" A="end" Size="22" W="700" Fill="var(--p-green)" Class="@FlashClass" />
    @if (modeChanged)
    {
        @* new active mode is boxed and flashes for 5 s *@
        <rect x="6" y="4" width="96" height="26" fill="none" stroke="#fff" stroke-width="1.5" class="flash" />
        <rect x="698" y="4" width="96" height="26" fill="none" stroke="#fff" stroke-width="1.5" class="flash" />
    }
</g>

@code {
    private FmaFields Fields => FmaTable.Resolve(P.FixedWing, S.Mode);
    private string AuthColor => Fields.Authority == "AP" ? "var(--p-green)" : "#fff";

    private string lastMode = "";
    private DateTime changedAt = DateTime.MinValue;
    private bool modeChanged => (DateTime.UtcNow - changedAt).TotalSeconds < 5;
    private string? FlashClass => modeChanged ? "flash" : null;

    protected override void OnParametersSet()
    {
        if (S.Mode == lastMode)
            return;
        if (lastMode.Length > 0)
            changedAt = DateTime.UtcNow;
        lastMode = S.Mode;
    }

    protected override object Key() => (S.Mode, S.Armed, S.Failsafe, S.LinkLost, modeChanged, P.FixedWing);
}
