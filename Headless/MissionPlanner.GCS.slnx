       android and maui-windows workloads; kept apart from MissionPlanner.Headless.slnx so the backend CI stays on net8. -->
  <Folder Name="/Libs/">
    <Project Path="Libs/MPBackend.ArduPilot/MPBackend.ArduPilot.csproj" />
