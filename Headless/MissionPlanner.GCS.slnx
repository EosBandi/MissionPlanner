  <Project Path="../ExtLibs/alglibnet/alglibnet.csproj" />
  <Project Path="../ExtLibs/Comms/MissionPlanner.Comms.csproj" />
  <Project Path="../ExtLibs/Core/Core.csproj" />
  <Project Path="../ExtLibs/GeoUtility/GeoUtility.csproj" />
  <Project Path="../ExtLibs/GMap.NET.Core/GMap.NET.Core.csproj" />
  <Project Path="../ExtLibs/ICSharpCode.SharpZipLib/ICSharpCode.SharpZipLib.csproj" />
  <Project Path="../ExtLibs/Interfaces/Interfaces.csproj" />
  <Project Path="../ExtLibs/Mavlink/MAVLink.csproj" />
  <Project Path="../ExtLibs/ProjNet/ProjNET.csproj" />
  <Project Path="../ExtLibs/Strings/MissionPlanner.Strings.csproj" />
  <Project Path="../ExtLibs/WinUSBNet/Nefarius.Drivers.WinUSB.csproj" />
  <Project Path="MPBackend.Core/MPBackend.Core.csproj" />
  <Project Path="MPBackend.UI/MPBackend.UI.csproj" />
